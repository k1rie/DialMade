# Dialmade works completely without AI. Copy this file to .env.local only if you want the optional
# "write copy with AI" feature hosted by your server. Users can always bring their own key instead
# (BYOK): it stays in their browser tab and never reaches this server or this budget.

# Anthropic API key used by POST /api/ai/copy. Server only: never prefix it with NEXT_PUBLIC_.
# Without it, /api/ai/copy answers 503 { code: "ai-not-configured" } and the UI offers BYOK.
ANTHROPIC_API_KEY=

# Model for the hosted route. Default: claude-opus-5-5 (with server-side refusal fallback).
# Prices per million tokens (input / output): claude-opus-5-5 $4 / $20, claude-sonnet-5-5 $2 / $10,
# claude-haiku-5-5 $0.10 / $0.50.
DIALMADE_AI_MODEL=claude-opus-5-5

# Thinking effort: low | medium | high | xhigh | max. Default: low (copy over a short brief).
DIALMADE_AI_EFFORT=low

# Hard monthly budget in USD (UTC calendar month). Before each request the server counts the prompt
# tokens and reserves the worst case (whole prompt + max_tokens at list price, plus a fallback hop);
# a request that does not fit is refused with HTTP 402. The paid call is never retried by the SDK nor
# cancelled by the client, so its real usage is always counted. Default: 5. A value that is set but
# not a number >= 0 (e.g. "$5") counts as 0 and turns the hosted AI off.
DIALMADE_AI_MONTHLY_BUDGET_USD=5

# Requests per client IP per UTC day (HTTP 429 after that). Default: 20.
DIALMADE_AI_MAX_REQUESTS_PER_IP_PER_DAY=20

# Self-hosting: reverse proxies in front of `next start` that append to X-Forwarded-For. The client
# IP is the entry this many places from the end (default 1). 0 ignores the header: one shared bucket.
# On Vercel x-real-ip is used instead.
# DIALMADE_TRUSTED_PROXY_HOPS=1

# NOTE: both counters live in the memory of the Node process. That holds for one long-lived server
# and for `next dev`. On serverless platforms (VERCEL, AWS_LAMBDA_FUNCTION_NAME, NETLIFY, K_SERVICE,
# FUNCTIONS_WORKER_RUNTIME detected) each instance would keep its own counters, so the hosted AI stays
# OFF there (503 ai-not-configured; BYOK still works) until the ledger is persisted (e.g. Supabase);
# see src/lib/ai/budget.ts. As an independent safety net, also set a spend limit on the API key's
# workspace in the Anthropic Console.

# --- App ------------------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Separate origin for the sandboxed preview runtime (iframe), planned.
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=es

# --- AI free tier, then BYOK (planned with the import feature) -------------------------------------
# Free AI uses per person per month (one use = one copy generation or one screenshot analysis).
DIALMADE_AI_FREE_USES_PER_MONTH=5
# Model for the free tier. Empty = same as DIALMADE_AI_MODEL. Example: claude-haiku-5-5
DIALMADE_AI_FREE_MODEL=
DIALMADE_AI_VISION_MAX_IMAGES=4
# Secret that signs the anonymous device id cookie. Generate one: openssl rand -hex 32
DIALMADE_DEVICE_ID_SECRET=

# --- Supabase (auth, share links, "My designs", persistent AI ledger) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role. Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Automation (optional) ------------------------------------------------------------------------
# Supabase CLI without interactive login (supabase link / db push).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Vercel CLI / CI deploys.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# owner/repo for releases and issues via gh (gh uses your own login).
GITHUB_REPO=

# --- Free-tier abuse protection (optional, free) --------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics and errors (optional; empty = off) -------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Feature flags ---------------------------------------------------------------------------------
DIALMADE_FEATURE_AI=true
DIALMADE_FEATURE_IMPORT=true
