# Dialmade works completely without AI. The hosted AI is a small FREE TIER paid by the project's hard
# monthly budget: each person (an anonymous signed device cookie until there is a login) gets a few AI
# uses per month (one use = one copy generation or one screenshot analysis). After that, the UI offers
# BYOK (the user's key stays in their browser tab and never reaches this server) or «Copiar prompt para
# mi Claude». Without any of this the app works the same.

# Anthropic API key used by POST /api/ai/*. Server only: never prefix it with NEXT_PUBLIC_.
# Without it, the routes answer 503 { code: "ai-not-configured" } and the UI offers BYOK.
ANTHROPIC_API_KEY=

# Model for BYOK and «Copiar prompt para mi Claude». Default: claude-opus-5-5.
# Prices per million tokens (input / output): claude-opus-5-5 $4 / $20, claude-sonnet-5-5 $2 / $10,
# claude-haiku-5-5 $0.10 / $0.50.
DIALMADE_AI_MODEL=claude-opus-5-5
# Model of the hosted free tier. Empty = same as DIALMADE_AI_MODEL. claude-haiku-5-5 has no server-side
# refusal fallback (none is sent); Opus/Sonnet 5.5 get `fallbacks: "default"`.
DIALMADE_AI_FREE_MODEL=

# Thinking effort: low | medium | high | xhigh | max. Default: low (copy over a short brief).
DIALMADE_AI_EFFORT=low

# Free AI uses per device per UTC month. 402 { code: "free-tier-exhausted", remaining: 0 } after them.
DIALMADE_AI_FREE_USES_PER_MONTH=5

# Hard monthly budget in USD for the whole free tier (UTC calendar month). Before each request the
# server counts the prompt tokens (count_tokens, images included) and reserves the worst case (whole
# prompt + max_tokens at list price, plus a fallback hop when fallbacks are on); a request that does not
# fit is refused with HTTP 402 budget-exceeded. The paid call is never retried by the SDK nor cancelled
# by the client, and is settled with its real usage. Default: 5. A value that is set but not a number
# >= 0 (e.g. "$5") counts as 0 and turns the hosted AI off.
DIALMADE_AI_MONTHLY_BUDGET_USD=5

# Requests per client IP per UTC day, whatever the device (HTTP 429 daily-limit after that). Default: 10.
DIALMADE_AI_MAX_REQUESTS_PER_IP_PER_DAY=10

# Signs the anonymous device id cookie (httpOnly) and salts the IP hashes of the ledger. 32+ characters.
# Generate one: openssl rand -hex 32. Required in production (without it the hosted AI is off); in
# development a random one per process is used. Changing it gives every device a new id.
DIALMADE_DEVICE_ID_SECRET=

# Screenshots one «Analizar estilo con IA» request takes: 1–4 (default 4; the answer's refIndex is 0–3).
DIALMADE_AI_VISION_MAX_IMAGES=4

# Self-hosting: reverse proxies in front of `next start` that append to X-Forwarded-For. The client
# IP is the entry this many places from the end. Next keeps a client-sent X-Forwarded-For when nothing
# is in front of it, so in production the header is only trusted when this is set: without a proxy
# leave it unset or 0 (every client shares one bucket of the daily limit); behind one proxy (nginx,
# Caddy, a load balancer) set 1. Development defaults to 1. On Vercel x-real-ip is used instead.
# DIALMADE_TRUSTED_PROXY_HOPS=1

# LEDGER. The counters (monthly spend, free uses per device, requests per IP) live in Supabase when
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY are set: apply supabase/migrations/*_ai_ledger.sql
# first (supabase db push). Without Supabase they live in the memory of the Node process, which is
# only allowed outside production: in production (NODE_ENV=production) or on serverless platforms
# without Supabase the hosted AI stays OFF (503 ai-not-configured; BYOK still works).
# memory = use the in-memory ledger in development even with Supabase configured (ignored in production).
# DIALMADE_AI_LEDGER=memory
# As an independent safety net, also set a spend limit on the API key's workspace in the Anthropic Console.

# --- App ------------------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Separate origin for the sandboxed preview runtime (iframe), planned.
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=es

# --- Supabase (share links, persistent AI ledger) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. It cannot read the AI ledger (RLS on,
# no policies, functions executable only by service_role).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role. Server only: never prefix with NEXT_PUBLIC_.
# Used by src/lib/supabase/server.ts for the AI ledger.
SUPABASE_SECRET_KEY=

# --- Accounts (Better Auth) and «Mis diseños» --------------------------------------------------
# Optional: without DATABASE_URL there are no accounts and the app works the same. All of these are
# server only: never prefix them with NEXT_PUBLIC_. The browser only learns which sign-in methods exist.
#
# Supabase's Postgres through the pooler (Supabase → Connect → Transaction pooler, port 6543):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Apply supabase/migrations/*_auth_designs.sql first (schemas dialmade_auth and dialmade).
DATABASE_URL=
# TLS: Supabase's certificate is signed by its own CA. Download it (Database settings → SSL
# Configuration) and paste the PEM (or its base64) here to verify it. Development without it
# encrypts without verifying; production refuses to start the database without it unless
# DATABASE_SSL=no-verify.
DATABASE_SSL_CA=
# DATABASE_SSL=no-verify
# Connections per process (default 5; 2 on serverless platforms).
# DIALMADE_DB_POOL_MAX=5

# Signs sessions and encrypts OAuth tokens. 32+ characters: openssl rand -base64 32. Required in
# production; in development a random one per process is used (sessions end on restart).
BETTER_AUTH_SECRET=
# Public origin of the app (https in production). Default: NEXT_PUBLIC_APP_URL in production and
# http://localhost:3700 in development. OAuth callbacks are <BETTER_AUTH_URL>/api/auth/callback/<provider>.
BETTER_AUTH_URL=
# Extra origins allowed to call /api/auth and /api/designs (comma separated), e.g. a preview domain.
BETTER_AUTH_TRUSTED_ORIGINS=

# OAuth apps (each provider shows «No configurado» until both values exist).
# GitHub: Settings → Developer settings → OAuth Apps. Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic link email. Development prints the link in the server console. Production needs a sender
# address and Resend (free tier: 3,000 emails/month) or any SMTP server; without them the magic link
# shows «No configurado».
DIALMADE_EMAIL_FROM=
RESEND_API_KEY=
# smtps://user:password@smtp.example.com:465 (or smtp://…:587 with STARTTLS)
SMTP_URL=
# Magic links per UTC day for the whole app (default 90: under Resend's free 100/day). Each address
# also gets at most 5 per hour, on top of the per-IP limit.
# DIALMADE_EMAIL_DAILY_CAP=90
# console | resend | smtp: force a transport (console is ignored in production).
# DIALMADE_EMAIL_TRANSPORT=console

# Subscriptions (Better Auth's Stripe plugin): installed and OFF. See docs/design/billing.md.
DIALMADE_FEATURE_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Automation (optional) ------------------------------------------------------------------------
# Supabase CLI without interactive login (supabase link / db push).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Vercel CLI / CI deploys.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# owner/repo for releases and issues via gh (gh uses your own login).
GITHUB_REPO=

# --- Free-tier abuse protection (optional, free) --------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics and errors (optional; empty = off) -------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Feature flags ---------------------------------------------------------------------------------
DIALMADE_FEATURE_AI=true
DIALMADE_FEATURE_IMPORT=true
