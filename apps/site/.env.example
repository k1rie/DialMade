# Copy this file to .env.local and set the public URLs before deploying. Without them the links point to
# the local ports (the build warns about it).

# Where the CTA «Empieza tu layout» leads. In local dev the app (apps/web) runs on port 3200.
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Where this landing is served. Base of canonical, hreflang, Open Graph, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3400
