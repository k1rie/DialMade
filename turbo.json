{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "DIALMADE_*",
        "SUPABASE_*",
        "ANTHROPIC_*",
        "DATABASE_*",
        "BETTER_AUTH_*",
        "GITHUB_CLIENT_*",
        "GOOGLE_CLIENT_*",
        "RESEND_API_KEY",
        "SMTP_URL",
        "STRIPE_*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DIALMADE_*",
        "SUPABASE_*",
        "ANTHROPIC_*",
        "DATABASE_*",
        "BETTER_AUTH_*",
        "GITHUB_CLIENT_*",
        "GOOGLE_CLIENT_*",
        "RESEND_API_KEY",
        "SMTP_URL",
        "STRIPE_*"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    }
  }
}
