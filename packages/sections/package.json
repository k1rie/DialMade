{
  "name": "@dialmade/sections",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Catálogo de secciones de las páginas del usuario (Guía de estilo, Landing page, Dashboard y componentes): registro, render de Pages del DesignDoc, copy determinista, minis y export a HTML estático.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./styles.css": "./src/styles.css",
    "./dialmade-sections.css": "./dist/dialmade-sections.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-css.mjs",
    "build:css": "node scripts/build-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dialmade/catalog": "workspace:*",
    "@dialmade/doc": "workspace:*",
    "@dialmade/ui": "workspace:*",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
