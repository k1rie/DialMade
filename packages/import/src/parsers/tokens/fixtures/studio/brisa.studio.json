{
  "core": {
    "colors": {
      "brisa": {
        "50": { "value": "#f0f4ff", "type": "color" },
        "500": { "value": "#3464d5", "type": "color" },
        "900": { "value": "#1b2560", "type": "color" }
      },
      "black": { "value": "#000000", "type": "color" },
      "white": { "value": "#ffffff", "type": "color" }
    },
    "spacing": {
      "base": { "value": "4", "type": "spacing" },
      "sm": { "value": "{spacing.base} * 2", "type": "spacing" },
      "md": { "value": "{spacing.base} * 4", "type": "spacing" }
    },
    "borderRadius": { "md": { "value": "8", "type": "borderRadius" } },
    "fontFamilies": {
      "heading": { "value": "Brisa Grotesk", "type": "fontFamilies" },
      "body": { "value": "Inter", "type": "fontFamilies" }
    },
    "fontWeights": {
      "heading": { "value": "Semi Bold", "type": "fontWeights" },
      "body": { "value": "Regular", "type": "fontWeights" }
    },
    "typography": {
      "h1": {
        "value": { "fontFamily": "{fontFamilies.heading}", "fontWeight": "{fontWeights.heading}", "fontSize": "48", "lineHeight": "110%", "letterSpacing": "-2%" },
        "type": "typography"
      }
    },
    "boxShadow": {
      "md": { "value": { "x": "0", "y": "4", "blur": "6", "spread": "-1", "color": "rgba({colors.black}, 0.1)", "type": "dropShadow" }, "type": "boxShadow" }
    }
  },
  "light": {
    "bg": { "default": { "value": "{colors.white}", "type": "color" } },
    "fg": { "default": { "value": "#111827", "type": "color" } },
    "primary": { "value": "{colors.brisa.500}", "type": "color" },
    "border": {
      "value": "{colors.black}",
      "type": "color",
      "$extensions": { "studio.tokens": { "modify": { "type": "alpha", "value": "0.1", "space": "srgb" } } }
    },
    "ring": {
      "value": "{colors.brisa.500}",
      "type": "color",
      "$extensions": { "studio.tokens": { "modify": { "type": "darken", "value": "0.2", "space": "lch" } } }
    }
  },
  "dark": {
    "bg": { "default": { "value": "#0a0a0d", "type": "color" } },
    "fg": { "default": { "value": "{colors.white}", "type": "color" } },
    "primary": { "value": "{colors.brisa.50}", "type": "color" }
  },
  "$themes": [
    { "id": "t-light", "name": "Light", "group": "Mode", "selectedTokenSets": { "core": "source", "light": "enabled", "dark": "disabled" } },
    { "id": "t-dark", "name": "Dark", "group": "Mode", "selectedTokenSets": { "core": "source", "dark": "enabled", "light": "disabled" } }
  ],
  "$metadata": { "tokenSetOrder": ["core", "light", "dark"] }
}
