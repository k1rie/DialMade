{
  "$description": "Brisa (fictional brand) · DTCG 2025.10",
  "color": {
    "$type": "color",
    "brisa": {
      "50": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.014, 262], "hex": "#f0f4ff" } },
      "100": { "$value": { "colorSpace": "oklch", "components": [0.93, 0.03, 262], "hex": "#e0e8fc" } },
      "300": { "$value": { "colorSpace": "oklch", "components": [0.78, 0.09, 262], "hex": "#a7b9f2" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.4, 0.55, 0.93], "hex": "#668ced" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.204, 0.392, 0.835], "hex": "#3464d5" } },
      "700": { "$value": { "colorSpace": "oklch", "components": [0.42, 0.15, 264], "hex": "#2a43a3" } },
      "900": { "$value": { "colorSpace": "oklch", "components": [0.28, 0.09, 266], "hex": "#1b2560" } }
    },
    "coral": {
      "500": { "$value": { "colorSpace": "hsl", "components": [12, 85, 60] } }
    },
    "primary": { "$value": "{color.brisa.500}", "$description": "Main actions" },
    "primary-foreground": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" } },
    "accent": { "$value": "{color.coral.500}" },
    "background": { "$value": { "colorSpace": "oklch", "components": [0.99, 0, "none"] } },
    "foreground": { "$value": { "colorSpace": "lab", "components": [12, 2, -12] } },
    "border": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1, "hex": "#000000" } },
    "ring": { "$value": { "$ref": "#/color/brisa/400/$value" } },
    "surface": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1] },
      "$extensions": { "mode": { "light": { "colorSpace": "srgb", "components": [1, 1, 1] }, "dark": "{color.brisa.900}" } }
    },
    "highlight-p3": { "$value": { "colorSpace": "display-p3", "components": [0.2, 0.4, 0.9], "hex": "#2b66ec" } },
    "legacy-hex": { "$value": "#ff8800" },
    "old-primary": { "$value": "#123456", "$deprecated": "Use color.primary" },
    "print": { "$value": { "colorSpace": "cmyk", "components": [0, 0, 0], "hex": "#abcdef" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 0.5, "unit": "rem" } },
    "lg": { "$value": "{radius.xl}" },
    "xl": { "$value": { "value": 16, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "spacing": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "8": { "$value": { "value": 32, "unit": "px" } }
  },
  "border-width": { "$type": "dimension", "default": { "$value": { "value": 1, "unit": "px" } } },
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": { "$value": ["Brisa Grotesk", "Arial", "sans-serif"] },
      "body": { "$value": "Inter, system-ui, sans-serif" },
      "mono": { "$value": ["Geist Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "heading": { "$value": "semi-bold" },
      "body": { "$value": 400 }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.05 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "md": {
      "$value": [
        { "color": "{color.brisa.900}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 6, "unit": "px" }, "spread": { "value": -1, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.06 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 4, "unit": "px" }, "spread": { "value": -2, "unit": "px" }, "inset": false }
      ]
    }
  },
  "typography": {
    "$type": "typography",
    "h1": {
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": { "value": 3, "unit": "rem" },
        "fontWeight": "{font.weight.heading}",
        "letterSpacing": { "value": -0.96, "unit": "px" },
        "lineHeight": 1.1
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": "{font.weight.body}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.5
      }
    }
  },
  "duration": { "$type": "duration", "fast": { "$value": { "value": 120, "unit": "ms" } } }
}
