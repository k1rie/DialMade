{
  "name": "@dialmade/import",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "«Trae tu marca»: detecta, lee y fusiona la guía del usuario (colores, CSS, tokens, DESIGN.md, capturas, fuentes) y la convierte en un JSON Patch del DesignDoc. TS puro, sin DOM.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "defaults": "node scripts/build-tailwind-defaults.mjs",
    "defaults:check": "node scripts/build-tailwind-defaults.mjs --check",
    "font-index": "node scripts/build-font-index.mjs",
    "font-index:check": "node scripts/build-font-index.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dialmade/catalog": "workspace:*",
    "@dialmade/doc": "workspace:*",
    "@dialmade/palette": "workspace:*",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
