{
  "name": "@dialmade/ai-render",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "«Diseño con IA»: contrato de salida, vocabulario de Tailwind con solo tokens, sanitizador, parser del stream, puertas de calidad, dirección de arte y export TSX. TS puro, sin DOM.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css": {
      "types": "./src/css.ts",
      "default": "./src/css.ts"
    },
    "./anthropic": {
      "types": "./src/anthropic.ts",
      "default": "./src/anthropic.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./css": {
        "types": "./dist/css.d.ts",
        "default": "./dist/css.js"
      },
      "./anthropic": {
        "types": "./dist/anthropic.d.ts",
        "default": "./dist/anthropic.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "preflight": "node scripts/build-preflight.mjs",
    "eval:variety": "vitest run --config eval/vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dialmade/catalog": "workspace:*",
    "@dialmade/doc": "workspace:*",
    "@dialmade/layout": "workspace:*",
    "@dialmade/palette": "workspace:*",
    "@dialmade/ui": "workspace:*",
    "parse5": "8.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@dialmade/sections": "workspace:*",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "0.128.0"
  }
}
