/** An icon of the set, drawn with the current text color (an unknown name draws a dot). */
export function Icon({ name, ...props }: { name: string } & Omit<SVGProps<SVGSVGElement>, "name">) {
  const paths = ICONS[name];
  return (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.75} strokeLinecap="round" strokeLinejoin="round" focusable="false" width="1em" height="1em" {...props}>
      {paths ? paths.map((d) => <path key={d} d={d} />) : <circle cx={12} cy={12} r={2.5} fill="currentColor" />}
    </svg>
  );
}

export type PlaceholderKind = "photo" | "avatar" | "logo" | "screenshot" | "chart" | "illustration";

/** Placeholder art painted with the theme's variables (it follows the palette and dark mode). */
export function Placeholder({ kind, alt = "", className }: { kind: PlaceholderKind; alt?: string; className?: string }) {
  const a11y = alt ? { role: "img", "aria-label": alt } : { "aria-hidden": true };
  switch (kind) {
    default:
    case "photo":
      return (
        <svg viewBox="0 0 480 320" preserveAspectRatio="xMidYMid slice" className={className} {...a11y}>
          <rect width="480" height="320" style={{ fill: "var(--muted, #eee)" }} />
          <path d="M0 249.60000000000002 L144 160 L240 217.60000000000002 L345.59999999999997 134.4 L480 224 V320 H0Z" style={{ fill: "var(--muted-foreground, #999)" }} opacity=".28" />
          <circle cx="345.59999999999997" cy="83.2" r="25.6" style={{ fill: "var(--muted-foreground, #999)" }} opacity=".35" />
        </svg>
      );
    case "avatar":
      return (
        <svg viewBox="0 0 96 96" className={className} {...a11y}>
          <rect width="96" height="96" style={{ fill: "var(--secondary, #ddd)" }} />
          <circle cx="48" cy="38" r="17" style={{ fill: "var(--muted-foreground, #999)" }} opacity=".55" />
          <path d="M16 92c4-20 18-30 32-30s28 10 32 30" style={{ fill: "var(--muted-foreground, #999)" }} opacity=".55" />
        </svg>
      );
    case "logo":
      return (
        <svg viewBox="0 0 160 48" className={className} {...a11y}>
          <rect x="4" y="12" width="24" height="24" rx="6" style={{ fill: "var(--primary, #555)" }} />
          <rect x="36" y="18" width="110" height="12" rx="6" style={{ fill: "var(--foreground, #333)" }} opacity=".75" />
        </svg>
      );
    case "screenshot":
      return (
        <svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice" className={className} {...a11y}>
          <rect width="640" height="400" style={{ fill: "var(--muted, #eee)" }} />
          <rect width="640" height="34" style={{ fill: "var(--card, #f6f6f6)" }} />
          <circle cx="20" cy="17" r="5" style={{ fill: "var(--border, #ccc)" }} />
          <circle cx="38" cy="17" r="5" style={{ fill: "var(--border, #ccc)" }} />
          <circle cx="56" cy="17" r="5" style={{ fill: "var(--border, #ccc)" }} />
          <rect x="20" y="58" width="140" height="322" rx="10" style={{ fill: "var(--card, #fff)" }} />
          <rect x="180" y="58" width="440" height="90" rx="10" style={{ fill: "var(--primary, #555)" }} opacity=".85" />
          <rect x="180" y="166" width="212" height="214" rx="10" style={{ fill: "var(--card, #fff)" }} />
          <rect x="408" y="166" width="212" height="214" rx="10" style={{ fill: "var(--card, #fff)" }} />
        </svg>
      );
    case "chart":
      return (
        <svg viewBox="0 0 480 240" preserveAspectRatio="xMidYMid slice" className={className} {...a11y}>
          <rect width="480" height="240" style={{ fill: "var(--muted, #eee)" }} />
          <rect x="24" y="176" width="24" height="40" rx="4" style={{ fill: "var(--chart-1, #888)" }} />
          <rect x="61" y="123" width="24" height="93" rx="4" style={{ fill: "var(--chart-2, #888)" }} />
          <rect x="98" y="70" width="24" height="146" rx="4" style={{ fill: "var(--chart-3, #888)" }} />
          <rect x="135" y="157" width="24" height="59" rx="4" style={{ fill: "var(--chart-4, #888)" }} />
          <rect x="172" y="104" width="24" height="112" rx="4" style={{ fill: "var(--chart-5, #888)" }} />
          <rect x="209" y="51" width="24" height="165" rx="4" style={{ fill: "var(--chart-1, #888)" }} />
          <rect x="246" y="138" width="24" height="78" rx="4" style={{ fill: "var(--chart-2, #888)" }} />
          <rect x="283" y="85" width="24" height="131" rx="4" style={{ fill: "var(--chart-3, #888)" }} />
          <rect x="320" y="172" width="24" height="44" rx="4" style={{ fill: "var(--chart-4, #888)" }} />
          <rect x="357" y="119" width="24" height="97" rx="4" style={{ fill: "var(--chart-5, #888)" }} />
          <rect x="394" y="66" width="24" height="150" rx="4" style={{ fill: "var(--chart-1, #888)" }} />
          <rect x="431" y="153" width="24" height="63" rx="4" style={{ fill: "var(--chart-2, #888)" }} />
        </svg>
      );
    case "illustration":
      return (
        <svg viewBox="0 0 480 360" preserveAspectRatio="xMidYMid slice" className={className} {...a11y}>
          <rect width="480" height="360" style={{ fill: "var(--muted, #eee)" }} />
          <circle cx="182.4" cy="162" r="100.80000000000001" style={{ fill: "var(--primary, #555)" }} opacity=".18" />
          <rect x="201.6" y="108" width="153.6" height="151.2" rx="18" style={{ fill: "var(--primary, #555)" }} opacity=".7" />
          <circle cx="336" cy="115.2" r="28.8" style={{ fill: "var(--accent, #aaa)" }} />
        </svg>
      );
  }
}
